APP_NAME=SpravaHub Documents
APP_ENV=production
BASE_URL=https://docs.spravahub.com.ua

# Один фіксований користувач.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
SESSION_SECRET=replace-with-random-64-char-secret
SESSION_HTTPS_ONLY=true

# OAuth token, отриманий scripts/google_oauth_setup.py
GOOGLE_TOKEN_FILE=/srv/app/secrets/google-token.json

# Папка для документів, які користувач обирає «Відкрити в Google Docs».
# Якщо ID порожній, папка з таким NAME буде знайдена або створена автоматично.
GOOGLE_GENERATED_FOLDER_ID=
GOOGLE_GENERATED_FOLDER_NAME=SpravaHub Generated Documents

# Master-шаблони Google Docs.
TEMPLATE_APPLICATION_RECALC_ID=13pl29xCjmo4fDtbHH8Cug5_ssGOqq_reyDW-k4dnjHg
TEMPLATE_CLAIM_INDEXATION_ID=157jeX1I3HERMeiFozpc-wtYOkExPdS4dXHfY2CKGQgY
TEMPLATE_CLAIM_RECALC_ID=1bu4hcNQnE9hWx4j6mmYSWTS0j3W4RkiUg2elqheO_OM

# Фіксовані офісні контакти.
OFFICE_CORRESPONDENCE_ADDRESS=02059, Київ, а/с 2
OFFICE_PHONE=0979091802
OFFICE_EMAIL=militarylawua@icloud.com

# Локальний режим: DOCX master-шаблони, синхронізовані один раз.
LOCAL_TEMPLATE_DIR=/srv/app/local_templates
LOCAL_TEMPLATE_APPLICATION_RECALC=application_recalc.docx
LOCAL_TEMPLATE_CLAIM_INDEXATION=claim_indexation.docx
LOCAL_TEMPLATE_CLAIM_RECALC=claim_recalc.docx
LOCAL_PDF_ENABLED=true
